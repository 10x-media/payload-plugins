	"scripts": {
		"build": "tsdown",
		"lint": "biome check src tests dev",
		"lint:fix": "biome check --write src tests dev",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm run test:clock && vitest run",
		"test:unit": "vitest run src",
		"test:clock": "vitest run src --config tests/setup/clock.config.mjs",
		"test:int": "vitest run tests/int",
		"test:matrix": "DB_MATRIX=mongo vitest run tests/int && DB_MATRIX=postgres vitest run tests/int && DB_MATRIX=sqlite vitest run tests/int && ANALYTICS_SQLITE_THREAD=main DB_MATRIX=sqlite vitest run tests/int",
		"test:container": "TEST_DB=container DB_MATRIX=mongo vitest run tests/int && TEST_DB=container DB_MATRIX=postgres vitest run tests/int",
		"test:e2e": "bash scripts/e2e.sh",
		"test:upgrade": "bash scripts/upgrade.sh",
		"test:load": "vitest run --config tests/load/vitest.config.ts",
		"dev": "pnpm --filter @10x-media/analytics-dev dev",
		"start": "pnpm --filter @10x-media/analytics-dev start",
		"generate": "pnpm --filter @10x-media/analytics-dev generate",
		"generate:types": "pnpm --filter @10x-media/analytics-dev generate:types",
		"generate:importmap": "pnpm --filter @10x-media/analytics-dev generate:importmap",
		"migrate": "pnpm --filter @10x-media/analytics-dev migrate",
		"migrate:create": "pnpm --filter @10x-media/analytics-dev migrate:create",
		"migrate:down": "pnpm --filter @10x-media/analytics-dev migrate:down",
		"migrate:refresh": "pnpm --filter @10x-media/analytics-dev migrate:refresh",
		"migrate:reset": "pnpm --filter @10x-media/analytics-dev migrate:reset",
		"migrate:status": "pnpm --filter @10x-media/analytics-dev migrate:status",
		"migrate:fresh": "pnpm --filter @10x-media/analytics-dev migrate:fresh",
		"clean": "rm -rf dist *.tsbuildinfo dev/.next"
	},
	"dependencies": {
		"country-flag-icons": "^1.6.20",
		"ipaddr.js": "^2.2.0",
