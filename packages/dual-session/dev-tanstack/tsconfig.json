{
	"extends": "@10x-media/tsconfig/base.json",
	"compilerOptions": {
		"noEmit": true,
		"allowJs": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@payload-config": ["./src/payload.config.ts"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "../src/**/*.d.ts"],
	"exclude": ["node_modules"]
}
