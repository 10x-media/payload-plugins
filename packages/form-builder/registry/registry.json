{
	"$schema": "https://ui.shadcn.com/schema/registry.json",
	"name": "form-builder",
	"homepage": "https://github.com/10x-media/payload-plugins",
	"items": [
		{
			"name": "form",
			"type": "registry:block",
			"title": "Form Builder (shadcn)",
			"description": "shadcn-styled field renderers and a <FormBuilderForm> wrapper for @10x-media/form-builder.",
			"author": "10x Media GmbH <https://github.com/10x-media>",
			"dependencies": ["@10x-media/form-builder"],
			"registryDependencies": ["input", "textarea", "label"],
			"files": [
				{
					"path": "form-builder/form-builder-form.tsx",
					"type": "registry:component",
					"target": "components/form-builder/form-builder-form.tsx"
				},
				{
					"path": "form-builder/renderers.tsx",
					"type": "registry:component",
					"target": "components/form-builder/renderers.tsx"
				},
				{
					"path": "form-builder/fields/text-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/text-field.tsx"
				},
				{
					"path": "form-builder/fields/textarea-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/textarea-field.tsx"
				},
				{
					"path": "form-builder/fields/email-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/email-field.tsx"
				},
				{
					"path": "form-builder/fields/number-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/number-field.tsx"
				},
				{
					"path": "form-builder/fields/select-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/select-field.tsx"
				},
				{
					"path": "form-builder/fields/checkbox-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/checkbox-field.tsx"
				},
				{
					"path": "form-builder/fields/file-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/file-field.tsx"
				},
				{
					"path": "form-builder/fields/message-field.tsx",
					"type": "registry:component",
					"target": "components/form-builder/fields/message-field.tsx"
				}
			]
		},
		{
			"name": "form-results",
			"type": "registry:component",
			"title": "Form Results (shadcn)",
			"description": "shadcn-styled <FormResults> for polls and survey summaries from @10x-media/form-builder.",
			"author": "10x Media GmbH <https://github.com/10x-media>",
			"dependencies": ["@10x-media/form-builder"],
			"files": [
				{
					"path": "form-builder/form-results.tsx",
					"type": "registry:component",
					"target": "components/form-builder/form-results.tsx"
				}
			]
		}
	]
}
