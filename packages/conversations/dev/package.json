{
	"name": "@10x-media/conversations-dev",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --turbo -p ${PORT:-3000}",
		"build": "next build",
		"start": "next start -p ${PORT:-3000}",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"generate": "pnpm generate:types && pnpm generate:importmap",
		"generate:types": "bash ../../../scripts/payload.sh . generate:types",
		"generate:importmap": "bash ../../../scripts/payload.sh . generate:importmap",
		"migrate": "bash ../../../scripts/payload.sh . migrate",
		"migrate:create": "bash ../../../scripts/payload.sh . migrate:create",
		"migrate:down": "bash ../../../scripts/payload.sh . migrate:down",
		"migrate:refresh": "bash ../../../scripts/payload.sh . migrate:refresh",
		"migrate:reset": "bash ../../../scripts/payload.sh . migrate:reset",
		"migrate:status": "bash ../../../scripts/payload.sh . migrate:status",
		"migrate:fresh": "bash ../../../scripts/payload.sh . migrate:fresh"
	},
	"dependencies": {
		"@10x-media/conversations": "workspace:*",
		"@base-ui/react": "^1.8.0",
		"@payloadcms/db-mongodb": "catalog:",
		"@payloadcms/db-postgres": "catalog:",
		"@payloadcms/next": "catalog:",
		"@payloadcms/plugin-multi-tenant": "catalog:",
		"@payloadcms/richtext-lexical": "catalog:",
		"@payloadcms/ui": "catalog:",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "catalog:",
		"next": "catalog:",
		"payload": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@10x-media/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "4.3.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"mongodb-memory-server": "^10.1.0",
		"tailwindcss": "4.3.0",
		"typescript": "catalog:"
	}
}
