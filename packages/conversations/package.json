{
	"name": "@10x-media/conversations",
	"version": "0.1.0-beta.0",
	"description": "Conversations for Payload: messages bound to any document, with channels, threads, mentions and read state",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/10x-media/payload-plugins.git",
		"directory": "packages/conversations"
	},
	"homepage": "https://github.com/10x-media/payload-plugins/tree/main/packages/conversations",
	"bugs": "https://github.com/10x-media/payload-plugins/issues",
	"keywords": [
		"payload",
		"payloadcms",
		"plugin",
		"comments",
		"chat",
		"conversations"
	],
	"author": "10x-media",
	"engines": {
		"node": ">=22.18.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"development": "./src/exports/types.ts",
			"types": "./src/exports/types.ts",
			"default": "./dist/exports/types.js"
		},
		"./client": {
			"development": "./src/exports/client.ts",
			"types": "./src/exports/client.ts",
			"default": "./dist/exports/client.js"
		},
		"./i18n": {
			"development": "./src/exports/i18n.ts",
			"types": "./src/exports/i18n.ts",
			"default": "./dist/exports/i18n.js"
		},
		"./react": {
			"development": "./src/exports/react.ts",
			"types": "./src/exports/react.ts",
			"default": "./dist/exports/react.js"
		},
		"./composer": {
			"development": "./src/exports/composer.ts",
			"types": "./src/exports/composer.ts",
			"default": "./dist/exports/composer.js"
		},
		"./comments": {
			"development": "./src/exports/comments.ts",
			"types": "./src/exports/comments.ts",
			"default": "./dist/exports/comments.js"
		},
		"./reactions": {
			"development": "./src/exports/reactions.ts",
			"types": "./src/exports/reactions.ts",
			"default": "./dist/exports/reactions.js"
		},
		"./reactions/react": {
			"development": "./src/exports/reactions-react.ts",
			"types": "./src/exports/reactions-react.ts",
			"default": "./dist/exports/reactions-react.js"
		},
		"./attachments": {
			"development": "./src/exports/attachments.ts",
			"types": "./src/exports/attachments.ts",
			"default": "./dist/exports/attachments.js"
		},
		"./attachments/react": {
			"development": "./src/exports/attachments-react.ts",
			"types": "./src/exports/attachments-react.ts",
			"default": "./dist/exports/attachments-react.js"
		},
		"./rsc": {
			"development": "./src/exports/rsc.ts",
			"types": "./src/exports/rsc.ts",
			"default": "./dist/exports/rsc.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"lint": "biome check src tests dev registry videos",
		"lint:fix": "biome check --write src tests dev registry videos",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run src",
		"test:int": "vitest run tests/int",
		"test:matrix": "DB_MATRIX=mongo vitest run tests/int/matrix.int.spec.ts tests/int/reactions.int.spec.ts tests/int/attachments.int.spec.ts tests/int/access.int.spec.ts tests/int/realtime.int.spec.ts tests/int/pusher.int.spec.ts tests/int/redis.int.spec.ts && DB_MATRIX=postgres vitest run tests/int/matrix.int.spec.ts tests/int/reactions.int.spec.ts tests/int/attachments.int.spec.ts tests/int/access.int.spec.ts tests/int/realtime.int.spec.ts tests/int/pusher.int.spec.ts tests/int/redis.int.spec.ts",
		"test:container": "TEST_DB=container DB_MATRIX=mongo vitest run tests/int/matrix.int.spec.ts tests/int/reactions.int.spec.ts tests/int/attachments.int.spec.ts tests/int/access.int.spec.ts tests/int/realtime.int.spec.ts tests/int/pusher.int.spec.ts tests/int/redis.int.spec.ts && TEST_DB=container DB_MATRIX=postgres vitest run tests/int/matrix.int.spec.ts tests/int/reactions.int.spec.ts tests/int/attachments.int.spec.ts tests/int/access.int.spec.ts tests/int/realtime.int.spec.ts tests/int/pusher.int.spec.ts tests/int/redis.int.spec.ts",
		"registry:build": "shadcn build registry.json --cwd registry --output r",
		"test:e2e": "bash scripts/e2e.sh",
		"videos": "clipwright videos",
		"dev": "pnpm --filter @10x-media/conversations-dev dev",
		"start": "pnpm --filter @10x-media/conversations-dev start",
		"generate": "pnpm --filter @10x-media/conversations-dev generate",
		"generate:types": "pnpm --filter @10x-media/conversations-dev generate:types",
		"generate:importmap": "pnpm --filter @10x-media/conversations-dev generate:importmap",
		"migrate": "pnpm --filter @10x-media/conversations-dev migrate",
		"migrate:create": "pnpm --filter @10x-media/conversations-dev migrate:create",
		"migrate:down": "pnpm --filter @10x-media/conversations-dev migrate:down",
		"migrate:refresh": "pnpm --filter @10x-media/conversations-dev migrate:refresh",
		"migrate:reset": "pnpm --filter @10x-media/conversations-dev migrate:reset",
		"migrate:status": "pnpm --filter @10x-media/conversations-dev migrate:status",
		"migrate:fresh": "pnpm --filter @10x-media/conversations-dev migrate:fresh",
		"clean": "rm -rf dist *.tsbuildinfo dev/.next"
	},
	"peerDependencies": {
		"@payloadcms/richtext-lexical": "^3.83.0",
		"@payloadcms/ui": "^3.83.0",
		"payload": "^3.83.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@10x-media/payload-test-harness": "workspace:*",
		"@10x-media/tsconfig": "workspace:*",
		"@10x-media/tsdown-config": "workspace:*",
		"@10x-media/vitest-config": "workspace:*",
		"@payloadcms/db-mongodb": "catalog:",
		"@payloadcms/db-postgres": "catalog:",
		"@payloadcms/richtext-lexical": "catalog:",
		"@payloadcms/ui": "catalog:",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"clipwright": "catalog:",
		"ioredis": "^5.4.1",
		"lucide-react": "catalog:",
		"payload": "catalog:",
		"playwright": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "^4.21.0",
		"testcontainers": "^12.0.1",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./types": {
				"types": "./dist/exports/types.d.ts",
				"import": "./dist/exports/types.js",
				"default": "./dist/exports/types.js"
			},
			"./client": {
				"types": "./dist/exports/client.d.ts",
				"import": "./dist/exports/client.js",
				"default": "./dist/exports/client.js"
			},
			"./i18n": {
				"types": "./dist/exports/i18n.d.ts",
				"import": "./dist/exports/i18n.js",
				"default": "./dist/exports/i18n.js"
			},
			"./react": {
				"types": "./dist/exports/react.d.ts",
				"import": "./dist/exports/react.js",
				"default": "./dist/exports/react.js"
			},
			"./composer": {
				"types": "./dist/exports/composer.d.ts",
				"import": "./dist/exports/composer.js",
				"default": "./dist/exports/composer.js"
			},
			"./comments": {
				"types": "./dist/exports/comments.d.ts",
				"import": "./dist/exports/comments.js",
				"default": "./dist/exports/comments.js"
			},
			"./reactions": {
				"types": "./dist/exports/reactions.d.ts",
				"import": "./dist/exports/reactions.js",
				"default": "./dist/exports/reactions.js"
			},
			"./reactions/react": {
				"types": "./dist/exports/reactions-react.d.ts",
				"import": "./dist/exports/reactions-react.js",
				"default": "./dist/exports/reactions-react.js"
			},
			"./attachments": {
				"types": "./dist/exports/attachments.d.ts",
				"import": "./dist/exports/attachments.js",
				"default": "./dist/exports/attachments.js"
			},
			"./attachments/react": {
				"types": "./dist/exports/attachments-react.d.ts",
				"import": "./dist/exports/attachments-react.js",
				"default": "./dist/exports/attachments-react.js"
			},
			"./rsc": {
				"types": "./dist/exports/rsc.d.ts",
				"import": "./dist/exports/rsc.js",
				"default": "./dist/exports/rsc.js"
			}
		}
	}
}
