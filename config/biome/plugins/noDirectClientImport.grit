language js

or {
	`import $items from "./exports/client"` where {
		register_diagnostic(span=$items, message="Server-side files cannot import from ./exports/client. Move shared code to a server-safe module.", severity="error")
	},
	`import $items from "./exports/react"` where {
		register_diagnostic(span=$items, message="Server-side files cannot import from ./exports/react. Move shared code to a server-safe module.", severity="error")
	}
}
