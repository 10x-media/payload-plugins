{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	// Files outside every package that still change what a build or test does. This list
	// is also what CI's affected scoping falls back on: turbo fans a globalDependencies
	// change out to all packages, so a catalog bump in pnpm-workspace.yaml or a root
	// devDependency bump re-runs the whole workspace instead of selecting nothing.
	"globalDependencies": [
		"tsconfig.json",
		"biome.json",
		"config/**",
		".npmrc",
		"package.json",
		"pnpm-workspace.yaml"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "package.json", "tsconfig.json", "tsdown.config.ts"],
			"outputs": ["dist/**", "*.tsbuildinfo"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"inputs": ["src/**", "tests/**", "dev/**", "registry/**", "videos/**", "biome.json"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"src/**",
				"tests/**",
				"dev/**",
				"tsconfig.json",
				"**/*.ts",
				"**/*.tsx",
				"!**/.next/**",
				"!**/.source/**",
				"!**/dist/**"
			],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["src/**", "tests/**", "dev/**", "registry/**", "vitest.config.ts"],
			"outputs": []
		},
		"test:unit": {
			"dependsOn": ["^typecheck"],
			"inputs": ["src/**", "tests/unit/**", "vitest.config.ts"],
			"outputs": []
		},
		"test:int": {
			"dependsOn": ["^typecheck"],
			"inputs": ["src/**", "tests/int/**", "vitest.config.ts"],
			"outputs": []
		},
		"test:matrix": {
			"inputs": ["src/**", "tests/int/**", "vitest.config.ts"],
			"outputs": [],
			"cache": false,
			"env": ["DB_MATRIX"]
		},
		"test:container": {
			"inputs": ["src/**", "tests/int/**", "vitest.config.ts"],
			"outputs": [],
			"cache": false,
			"env": ["DB_MATRIX", "TEST_DB"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "tests/e2e/**", "playwright.config.ts", "docker-compose.test.yml"],
			"outputs": ["playwright-report/**", "test-results/**"],
			"cache": false
		},
		"test:dist": {
			"dependsOn": ["build"],
			"inputs": ["src/**", "tests/dist/**", "vitest.config.ts", "tsdown.config.ts"],
			"outputs": []
		},
		"generate": {
			"cache": false
		},
		"generate:types": {
			"cache": false
		},
		"generate:importmap": {
			"cache": false
		},
		"migrate": { "cache": false },
		"migrate:create": { "cache": false },
		"migrate:down": { "cache": false },
		"migrate:refresh": { "cache": false },
		"migrate:reset": { "cache": false },
		"migrate:status": { "cache": false },
		"migrate:fresh": { "cache": false },
		"clean": {
			"cache": false
		}
	}
}
