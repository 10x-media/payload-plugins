# deps
node_modules/
.pnp
.pnp.js

# build
dist/
# dist isolation specs are source, not build output
!**/tests/dist/
.turbo/
*.tsbuildinfo
*.tgz

# next (docs + plugin dev apps)
**/.next/
apps/docs/out/
apps/docs/.contentlayer/
apps/docs/.source/
next-env.d.ts

# test artifacts
coverage/
playwright-report/
test-results/

# clipwright's default output directory; the showcase clips are rendered
# straight into apps/docs/public/videos and committed from there
packages/*/videos/out/

# dev app upload storage
packages/*/dev/uploads/

# admin-wiki wiki media uploads
packages/admin-wiki/dev/wiki-media/

# env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.pem

# local scratch / superpowers state (internal planning, not part of the published repo)
.superpowers/
docs/superpowers/

# per-developer Claude Code overrides (settings.json is committed)
.claude/settings.local.json
# isolated worktrees created by Claude Code (EnterWorktree); not part of the repo
.claude/worktrees/

# misc
note.md
*.log
