{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"extends": ["./config/biome/biome.json"],
	"plugins": [
		"./config/biome/plugins/noProcessEnv.grit",
		"./config/biome/plugins/noRelativeCrossModule.grit",
		"./config/biome/plugins/requirePluginFactoryShape.grit",
		"./config/biome/plugins/requireI18nKeysTyped.grit",
		"./config/biome/plugins/noDirectClientImport.grit"
	],
	"overrides": [
		{
			"includes": [
				"**/src/fields/icon/adapters/*/generated/**",
				"**/dev/icon-adapters/*/generated/**"
			],
			"formatter": { "enabled": false },
			"linter": { "enabled": false },
			"assist": { "enabled": false }
		},
		{
			"includes": ["**/registry/**"],
			"linter": {
				"rules": {
					"a11y": { "noLabelWithoutControl": "off" }
				}
			}
		}
	]
}
