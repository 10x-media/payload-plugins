import { type Config, definePlugin } from 'payload'

import { registerTranslations } from './plugin/registerTranslations'

export type {{pluginPascal}}PluginOptions = {
	/**
	 * Disable the plugin entirely (incoming config returned untouched).
	 * Useful for opting out per environment without removing the plugin call.
	 */
	disabled?: boolean
}

declare module 'payload' {
	interface RegisteredPlugins {
		'@10x-media/{{pluginSlug}}': {{pluginPascal}}PluginOptions
	}
}

/**
 * {{pluginTitle}} plugin for Payload v3. Currently registers this plugin's
 * translations; future releases will add feature behavior. Authored with
 * `definePlugin` so sibling plugins can detect it by slug.
 */
export const {{pluginCamel}} = definePlugin<{{pluginPascal}}PluginOptions>({
	slug: '@10x-media/{{pluginSlug}}',
	plugin: ({ config, plugins: _plugins, ...options }): Config => {
		if (options.disabled === true) {
			return config
		}
		registerTranslations(config)
		return config
	},
})

export type { {{pluginPascal}}PluginOptions as PluginOptions }
