{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"app/**",
				"components/**",
				"content/**",
				"lib/**",
				"public/**",
				"!public/r/**",
				"scripts/**",
				"$TURBO_ROOT$/packages/*/registry/r/**",
				"next.config.ts",
				"source.config.ts",
				"postcss.config.mjs",
				"package.json",
				"tsconfig.json"
			],
			"outputs": ["out/**", ".next/**", "!.next/cache/**"]
		}
	}
}
